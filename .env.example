# ========================================
# 서버 설정
# ========================================
DEBUG=False
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ========================================
# LLM & AI (필수)
# ========================================
# Google Gemini API 키 생성: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# ========================================
# 카카오 챗봇 설정 (필수)
# ========================================
# 카카오 i 오픈빌더에서 확인
KAKAO_APP_ID=your_kakao_app_id
KAKAO_APP_SECRET=your_kakao_app_secret

# 카카오 콜백 URL (예시: Render 배포 후)
# https://your-app.onrender.com/v1/callback
KAKAO_CALLBACK_URL=http://localhost:8000/v1/callback

# ========================================
# 타임아웃 설정 (밀리초)
# ========================================
HTTP_TIMEOUT=8000
FINANCE_TIMEOUT=5000
SUMMARY_TIMEOUT=10000

# ========================================
# 로깅
# ========================================
LOG_LEVEL=INFO
